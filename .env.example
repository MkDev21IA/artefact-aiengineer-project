# =============================================================================
# Emporio da Musica AI Agent — Environment Configuration
# Copy this file to `.env` and fill in your API key before running the agent.
# =============================================================================

# Required: OpenAI API credentials
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Operational Store Settings (Campo Grande - MS headquarters)
STORE_TIMEZONE=America/Campo_Grande
DOCUMENTS_DIR=documents
CHROMA_PERSIST_DIR=.chroma

# Session & Orchestrator Settings
SESSION_TTL_SECONDS=1800
MAX_HISTORY_MESSAGES=20
MAX_TOOL_ITERATIONS=5

# Embedding Model (Shared across ChromaDB RAG and Semantic Router Guardrails)
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
