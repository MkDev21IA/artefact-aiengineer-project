# =============================================================================
# Emporio da Musica AI Agent — Environment Configuration
# Copy this file to `.env` and configure EITHER OpenRouter OR OpenAI below.
# =============================================================================

# Option A — OpenRouter (OpenAI-compatible API; auto-routes to https://openrouter.ai/api/v1)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Option B — Direct OpenAI API (or any custom OpenAI-compatible endpoint)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Operational Store Settings (Campo Grande - MS headquarters)
STORE_TIMEZONE=America/Campo_Grande
DOCUMENTS_DIR=documents
CHROMA_PERSIST_DIR=.chroma

# Session & Orchestrator Settings
SESSION_TTL_SECONDS=1800
MAX_HISTORY_MESSAGES=20
MAX_TOOL_ITERATIONS=5

# Embedding Model (Shared across ChromaDB RAG and Semantic Router Guardrails)
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
